{
  "name": "vaasa-aluekartta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "data:update": "node scripts/update-osm-boundaries.mjs && node scripts/enrich-wikidata-metadata.mjs && npm run pois:update && npm run stats:check",
    "pois:update": "node scripts/update-osm-pois.mjs",
    "stats:check": "node scripts/validate-area-statistics.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run stats:check && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
